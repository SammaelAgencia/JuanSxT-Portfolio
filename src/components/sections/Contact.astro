---
import { site, siteCopy, socials } from '@data/site';
import { ui } from '@data/ui';
import { langOf } from '@i18n';
import SplitText from '@components/ui/SplitText.astro';

const lang = langOf(Astro.url.pathname);
const copy = siteCopy[lang];
const t = ui[lang];
---

<section class="section contact" id="contacto" data-theme="light">
  <span class="contact__wash" aria-hidden="true">{site.shortName}</span>

  <div class="shell contact__inner">
    <div class="contact__eyebrow">
      <span class="pill">
        <span class="pill__dot" aria-hidden="true"></span>
        {copy.availability.label}
      </span>
    </div>

    <SplitText as="h2" class="contact__title" lines={t.contact.title} />

    <div class="contact__mail copy" data-reveal style="--reveal-delay:320ms">
      <a
        class="link"
        href={`mailto:${site.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`}
        data-cursor-hint="link"
      >
        {site.email}
      </a>
      <button
        type="button"
        class="u-mono link link--in"
        data-copy={site.email}
        data-copy-done={t.contact.copyStatus}
        data-cursor-hint="copy"
      >
        {t.contact.copy}
      </button>
      <span class="copy__flag" aria-hidden="true">{t.contact.copied}</span>
      <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
    </div>

    <div class="contact__actions" data-reveal style="--reveal-delay:420ms">
      <a
        class="btn btn--lg"
        href={`https://wa.me/${site.phoneHref.replace('+', '')}`}
        target="_blank"
        rel="noopener"
        data-magnetic
        data-cursor-hint="link"
      >
        {t.contact.whatsapp}
        <span class="btn__arrow" aria-hidden="true">↗</span>
      </a>
      <a class="btn btn--ghost btn--lg" href={`tel:${site.phoneHref}`} data-cursor-hint="link">
        {site.phone}
      </a>
    </div>

    <div class="contact__channels" data-reveal style="--reveal-delay:520ms">
      <dl class="channel">
        <dt>{t.contact.availability}</dt>
        <dd>{copy.availability.detail}</dd>
      </dl>

      <dl class="channel">
        <dt>{t.contact.location}</dt>
        <dd>{copy.location} · {site.timezone}</dd>
      </dl>

      {
        socials.map((social) => (
          <dl class="channel">
            <dt>{social.label}</dt>
            <dd>
              <a class="link link--in" href={social.href} target="_blank" rel="noopener" data-cursor-hint="link">
                @{social.handle}
              </a>
            </dd>
          </dl>
        ))
      }
    </div>
  </div>
</section>
